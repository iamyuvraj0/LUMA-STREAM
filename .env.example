TMDB_TOKEN=your_full_tmdb_api_read_access_token
PORT=3000
TMDB_REGION=NP
PUBLIC_SITE_URL=https://sunaa.live
# PostgreSQL URL from Neon (recommended) or another persistent Postgres provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# TRUST_PROXY_HOPS=1 # use only when deployed behind one trusted reverse proxy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-unique-random-password-at-least-12-characters-long

# IP lookup is used only to estimate city/region/country; disable with false
VISITOR_GEOLOCATION=true
